        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-bootstrap</artifactId>
    <name>agent-bootstrap</name>
    <description>Spring Boot startup module — assembles all modules</description>

    <dependencies>
        <dependency>
            <groupId>com.ksyun.agent</groupId>
            <artifactId>agent-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ksyun.agent</groupId>
            <artifactId>agent-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ksyun.agent</groupId>
            <artifactId>agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ksyun.agent</groupId>
            <artifactId>agent-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
